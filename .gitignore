# Ignore dependencies
node_modules/

# Local session storage & temporary logs
sessions/*
!sessions/.gitkeep
*.log

# Operating system files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Local SQLite fallback database (MySQL speace_db.sql is used for Git)
database/speace.sqlite

# User uploaded images (keep directory structure)
uploads/*
!uploads/.gitkeep
